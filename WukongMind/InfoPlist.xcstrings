{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "App name on the Home Screen. The brand name; not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind"
          }
        }
      },
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "comment" : "Bundle name. The brand name; not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description: shown when a forum page in the browser asks for a photo or video.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A forum page can ask for a photo or video, for example a profile picture or an attachment to your post."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "论坛网页可能会请求拍摄照片或视频，例如头像或帖子附件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "論壇網頁可能會要求拍攝照片或影片，例如大頭貼或貼文附件。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description: shown when iOS asks for local-network access (Ollama or LM Studio).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind can connect to an Ollama or LM Studio server on your local network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind 可以连接你本地网络上的 Ollama 或 LM Studio 服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind 可以連線到你區域網路上的 Ollama 或 LM Studio 伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description: shown before the first dictation or voice session, or when a forum page asks to record a video.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind uses the microphone to turn your speech into text when you dictate a question, when you talk to its voice assistant, and when a forum page asks you to record a video with sound."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你口述问题、与 WukongMind 的语音助手对话，以及论坛网页请求录制带声音的视频时，WukongMind 会使用麦克风，把你的语音转成文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你口述問題、與 WukongMind 的語音助理對話，以及論壇網頁要求錄製含聲音的影片時，WukongMind 會使用麥克風，將你的語音轉成文字。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description: shown when the user saves an image from a forum page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind can save images from forum pages to your photo library when you ask it to."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你要求时，WukongMind 可以将论坛网页中的图片保存到你的照片图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你要求時，WukongMind 可以將論壇網頁中的圖片儲存到你的照片圖庫。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description: shown before the first dictation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind uses speech recognition to turn what you say into text in the input box. Where your language is not supported on the device, Apple processes the audio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind 使用语音识别，把你说的话转成输入框里的文字。如果设备本身不支持你的语言，音频会交给 Apple 处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WukongMind 使用語音辨識，將你說的話轉成輸入框裡的文字。如果裝置本身不支援你的語言，音訊會交給 Apple 處理。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
