{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "shouldTranslate" : false
    },
    "%@ API key is required." : {
      "comment" : "Error; the placeholder is the AI provider's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 金鑰。"
          }
        }
      }
    },
    "%@ API key is required. Add it in Settings › AI models." : {
      "comment" : "Error; the placeholder is the AI provider's name. Settings › AI models names the app's own Settings pages.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 密钥。请在“设置 › AI 模型”中添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 金鑰。請在「設定 › AI 模型」中加入。"
          }
        }
      }
    },
    "%@ doesn’t look like a supported site. WukongMind works with %@." : {
      "comment" : "Add forum error; the first placeholder is a web address such as forum.example.com, the second the supported platforms such as Discourse and WordPress",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 看起来不是受支持的网站。WukongMind 适用于 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 看起來不是受支援的網站。WukongMind 適用於 %@。"
          }
        }
      }
    },
    "%@ home" : {
