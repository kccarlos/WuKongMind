        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”使用单独的模型。请选择一个模型以继续；之后可在“设置 › AI 模型”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
